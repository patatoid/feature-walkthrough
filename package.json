{
  "name": "feature-walkthrough",
  "version": "0.1.0",
  "author": "patatoid <pascal@malach.it>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:wasm": "cargo build --manifest-path wasm/phi-walkthrough/Cargo.toml --target wasm32-unknown-unknown --release && cp wasm/phi-walkthrough/target/wasm32-unknown-unknown/release/phi_walkthrough_wasm.wasm public/phi_walkthrough_bg.wasm",
    "build:tic-tac-toe-model": "npm run build:wasm && node scripts/build-tic-tac-toe-model.js",
    "train:tic-tac-toe": "node scripts/train-tic-tac-toe.js",
    "test:tic-tac-toe": "node --test scripts/train-tic-tac-toe.test.js scripts/tic-tac-toe-phi.test.js",
    "test:wasm": "cargo test --manifest-path wasm/phi-walkthrough/Cargo.toml",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "core-js": "^3.8.3",
    "jose": "^6.2.3",
    "openai": "^4.77.0",
    "vue": "^2.7.16",
    "vue-async-computed": "^3.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vue-template-compiler": "^2.7.16"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
